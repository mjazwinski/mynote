# Copy to .env and adjust. Do not commit .env.

# MongoDB root credentials (used by the mongo container and the backend connection string).
# Avoid characters that need URL-encoding (@ : / ? # %) in the password.
MONGO_ROOT_USER=mynote
MONGO_ROOT_PASSWORD=change-me

# Database name used by the backend
MONGODB_DB=mynote

# Backend log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Host port for the web UI
FRONTEND_PORT=8080
